# Supabase: Dashboard → Project Settings → API
# Database: Dashboard → Project Settings → Database → Connection string

# --- Supabase (Auth + API) ---

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Postgres (Alembic + direct DB access) ---

# Use the DIRECT connection (db.<ref>.supabase.co, needs IPv6) or the SESSION pooler
# (pooler.supabase.com, port 5432, works on IPv4).
# Do NOT use the TRANSACTION pooler (port 6543) — migrations require a session connection.
# URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# --- OpenAI (needed once the LLM / embedding layer is wired up) ---

OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# --- Server ---

# Comma-separated browser origins allowed to call the API (CORS): the Flutter web app (flutter run -d chrome --web-port 3000).
ALLOWED_ORIGINS=http://localhost:3000
