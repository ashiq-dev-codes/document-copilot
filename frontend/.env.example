# Supabase: Dashboard → Project Settings → API Keys
# Only public values belong here — never the service_role/secret key or the database URL.
# EXPO_PUBLIC_ values are copied into the app, so anyone with the app can read them.

# --- Backend API ---

# On a phone, localhost is the phone itself: use your computer's Wi-Fi IP.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:8000

# --- Supabase (app auth) ---

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
